{
  "name": "CarServiceArchiver",
  "private": true,
  "version": "0.35.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:msix-draft": "tsc && vite build && electron-builder --win appx",
    "test:v35": "node scripts/v35-source-check.mjs && node scripts/v35-restore-ui-check.mjs && node scripts/v35-restore-relaunch-check.mjs && node scripts/v35-media-ux-check.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-check.mjs",
    "test:db": "node scripts/db-migration-test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:smoke && npm run test:db && npm run test:car-owner && npm run test:service-atomicity && npm run test:service-integration && npm run test:trash && npm run test:i18n && npm run test:v35 && npm run test:security && npm run test:ux-fixes && npm run test:window-drag",
    "test:car-owner": "node scripts/car-owner-history-test.mjs",
    "test:service-atomicity": "node scripts/service-atomicity-check.mjs",
    "test:service-integration": "node scripts/service-integration-test.mjs",
    "test:i18n": "node scripts/i18n-audit.mjs --strict --strict-literals",
    "test:trash": "node scripts/trash-integration-test.mjs",
    "postinstall": "node scripts/native-abi.mjs ensure",
    "predev": "node scripts/native-abi.mjs ensure",
    "native:check": "node scripts/native-abi.mjs check",
    "native:rebuild": "node scripts/native-abi.mjs rebuild",
    "security:upgrade": "node scripts/security-upgrade.mjs",
    "test:security": "node scripts/security-boundary-check.mjs && node scripts/offline-media-boundary-test.mjs",
    "test:ux-fixes": "node scripts/v35-ux-nine-check.mjs",
    "release:check": "node scripts/release-preflight.mjs",
    "release:gate": "node scripts/release-preflight.mjs --strict",
    "test:release": "node scripts/release-preflight-test.mjs",
    "test:window-drag": "node scripts/window-drag-regression.mjs"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "0.45.4",
    "i18next": "^26.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^20.17.30",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.9",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
